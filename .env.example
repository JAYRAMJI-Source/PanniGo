# Server
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example

# Supabase: keep SERVICE ROLE key server-side only. Never put it in browser code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Admin
PAANIGO_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional Razorpay online payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
